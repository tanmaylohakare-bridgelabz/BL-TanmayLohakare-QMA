# Stage 1: Build
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# Copy the Parent POM
COPY pom.xml .

# FIX: Remove the <modules> section from the root pom.xml so Maven doesn't look for missing folders
RUN sed -i '/<modules>/,/<\/modules>/d' pom.xml

# Copy the eureka-server folder
COPY eureka-server/ eureka-server/

# Build only the eureka-server
RUN mvn clean package -pl eureka-server -DskipTests

# Stage 2: Run
FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY --from=build /app/eureka-server/target/*.jar app.jar

EXPOSE 8761
ENTRYPOINT ["java","-jar","app.jar"]
